{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "popdriver Chrome (local CORS)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "deviceId": "chrome",
      "args": [
        "--web-browser-flag=--disable-web-security",
        "--web-browser-flag=--user-data-dir=/tmp/popdriver_chrome_cors"
      ]
    }
  ]
}
